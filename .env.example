# ============================================
# CycleX 環境変数サンプル
# `cp .env.example .env.local` して各値を設定してください
# ============================================

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
# 販売手数料率(表示のみに使用。精算処理は本システムの対象外)
PLATFORM_FEE_RATE=0.07

# ---- Supabase ----
# ローカル: `pnpm supabase start` の出力値を使用
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# server-only。src/lib/supabase/admin.ts からのみ参照すること
SUPABASE_SERVICE_ROLE_KEY=
# `supabase db push` 用の direct connection 文字列(本番のみ)
SUPABASE_DB_URL=

# ---- Stripe(テストモード)----
STRIPE_SECRET_KEY=sk_test_xxx
# `stripe listen --forward-to localhost:3000/api/webhooks/stripe` の出力値
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ---- Resend ----
RESEND_API_KEY=
EMAIL_FROM="CycleX <noreply@example.com>"

# ---- Cron 保護 ----
# /api/cron/daily の Authorization: Bearer に使用
CRON_SECRET=

# デモ決済(Stripe を構成する前に購入〜取引完了まで通しで確認するため)
# STRIPE_SECRET_KEY が未設定のときだけ有効になる。本番では設定しない
ALLOW_DEMO_CHECKOUT=

# 検証公開の間だけ検索エンジンに載せない(1 で robots.txt を全面拒否)。一般公開時は外す
NEXT_PUBLIC_NOINDEX=
